import gradio as gr

def predict_sales(Store, Holiday_Flag, Temperature, Fuel_Price, CPI, Unemployment, Year, Month, Week):
    input_data = pd.DataFrame([{
        "Store": Store,
        "Holiday_Flag": Holiday_Flag,
        "Temperature": Temperature,
        "Fuel_Price": Fuel_Price,
        "CPI": CPI,
        "Unemployment": Unemployment,
        "Year": Year,
        "Month": Month,
        "Week": Week
    }])

    input_scaled = scaler.transform(input_data)
    prediction = rf.predict(input_scaled)
    return round(prediction[0], 2)

inputs = [
    gr.Number(label="Store Number"),
    gr.Radio([0,1], label="Holiday Flag (0=No, 1=Yes)"),
    gr.Number(label="Temperature"),
    gr.Number(label="Fuel Price"),
    gr.Number(label="CPI"),
    gr.Number(label="Unemployment"),
    gr.Number(label="Year"),
    gr.Number(label="Month"),
    gr.Number(label="Week Day (0–6)")
]

output = gr.Number(label="Predicted Weekly Sales")

gr.Interface(
    fn=predict_sales,
    inputs=inputs,
    outputs=output,
    title=" 🛒 Walmart Weekly Sales Predictor",
    description="Enter store and economic details to predict weekly sales."
).launch()
